{
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:affected": "node scripts/affected-tests.mjs",
    "db:migrate": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mjs seed",
    "db:reset": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mjs reset"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.5",
    "bcryptjs": "^2.4.2",
    "clsx": "^2.1.1",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "postcss": "^8.5.32",
    "postgres": "^3.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "use-debounce": "^10.1.1",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "5.7.3",
    "vitest": "~4.1.11"
  },
  "allowScripts": {
    "unrs-resolver": false
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}

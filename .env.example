# Copy to .env and fill in. Never commit .env. (README.md, "First run".)

# Required.

# The PostgreSQL server, database and schema, with TLS: the app requires it.
# e.g. postgres://user:password@localhost:5432/xenocats?sslmode=require&search_path=xenocats
POSTGRES_URL=
# Signs the sessions (Auth.js), and keys the hashed client addresses the sign-up and
# login limits count. Any long random string, e.g. from
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Where the app is served, for Auth.js's redirects, e.g. http://localhost:3000
AUTH_URL=

# Optional.

# Failed logins in a row before a login name is refused, and for how many minutes
# (defaults 5 and 15).
LOGIN_MAX_FAILURES=
LOGIN_LOCK_MINUTES=
# Failed logins from one client address, across every name, before it is refused
# for the same minutes (default 20). Needs a trusted proxy header (below).
LOGIN_ADDRESS_MAX_FAILURES=
# Accounts one client address may make a day (default 2).
SIGNUP_MAX_PER_DAY=
# The header a proxy in front of the app sets with the client's address:
# x-real-ip, or x-forwarded-for (its last entry). Only if the proxy overwrites it.
# Vercel needs none (VERCEL=1 is set there, and X-Real-IP believed). Without one,
# every client shares the sign-up limit, and the per-address login limit is off.
TRUSTED_PROXY_HEADER=
